# Public (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Canonical site origin for Auth email redirects (confirmation + password recovery).
# Required in production/preview so redirects are not derived only from VERCEL_URL.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Server-only (never commit real values)
# Public owner self-registration remains closed unless explicitly enabled.
PUBLIC_REGISTRATION_ENABLED=false
# Invitations application rollout gate (fail-closed). Not a NEXT_PUBLIC_ flag.
# Requires a deployment that uses this environment state to take effect.
INVITATIONS_ENABLED=false
# Invitation email delivery gate (CB-E1). Fail-closed; only exact "true" enables.
# Keep OFF until provider/DNS/secrets/allowlist are owner-approved (CB-E1-D/E).
INVITATION_EMAIL_DELIVERY_ENABLED=false
# Server-only Resend API key. Never use NEXT_PUBLIC_RESEND_API_KEY.
# RESEND_API_KEY=
# Sender identity, e.g. ZyntixAI <invites@example.com> (no fake production default).
# INVITATION_EMAIL_FROM=
# Comma-separated recipient allowlist (normalized). Empty/missing fails closed when delivery ON.
# INVITATION_EMAIL_RECIPIENT_ALLOWLIST=
# AES-GCM sealing for Invitation continuation / registration-origin cookies.
# INVITE_CONTINUATION_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_PASSWORD=
# SUPABASE_ACCESS_TOKEN=

# Social Media (SMM) — fail-closed; never NEXT_PUBLIC_ for secrets/gates.
# SOCIAL_CONNECTIONS_ENABLED=false
# SOCIAL_INSTAGRAM_CONNECTIONS_ENABLED=false
# SOCIAL_PUBLISHING_ENABLED=false
# B1.8 execute requires SOCIAL_PUBLISHING_ENABLED=true and remains false/unset by default.
# Do not set true except for one owner-authorized controlled IMAGE publish.
# SOCIAL_INSTAGRAM_CLIENT_ID=
# SOCIAL_INSTAGRAM_CLIENT_SECRET=
# SOCIAL_INSTAGRAM_OAUTH_REDIRECT_URI=
# SOCIAL_CREDENTIAL_ENCRYPTION_KEY=
# SOCIAL_MEDIA_PROVIDER_DELIVERY_SIGNING_SECRET=
# Narrow private-bucket download credential for HMAC media-delivery only.
# Never expose as NEXT_PUBLIC_. Prefer a Storage-scoped secret when available.
# SOCIAL_PRIVATE_MEDIA_STORAGE_KEY=
