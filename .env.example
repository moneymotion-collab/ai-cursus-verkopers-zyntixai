# Public (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Canonical site origin for Auth email redirects (confirmation + password recovery).
# Required in production/preview so redirects are not derived only from VERCEL_URL.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Server-only (never commit real values)
# Public owner self-registration remains closed unless explicitly enabled.
PUBLIC_REGISTRATION_ENABLED=false
# Invitations application rollout gate (fail-closed). Not a NEXT_PUBLIC_ flag.
# Requires a deployment that uses this environment state to take effect.
INVITATIONS_ENABLED=false
# AES-GCM sealing for Invitation continuation / registration-origin cookies.
# INVITE_CONTINUATION_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_PASSWORD=
# SUPABASE_ACCESS_TOKEN=
